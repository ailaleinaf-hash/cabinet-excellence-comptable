@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap');

:root {
  --navy: #081426;
  --navy-light: #10213a;
  --gold: #d6b273;
  --gold-light: #f0d5a0;
  --white: #ffffff;
  --ivory: #f7f5f0;
  --text: #344054;
  --muted: #a8b0bd;
  --line: rgba(214, 178, 115, 0.28);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 90px;
}

body {
  font-family: 'DM Sans', Arial, sans-serif;
  color: var(--text);
  background: var(--ivory);
  line-height: 1.7;
  overflow-x: hidden;
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  font: inherit;
}

::selection {
  color: var(--navy);
  background: var(--gold);
}

/* NAVIGATION */

.header {
  position: absolute;
  inset: 0 0 auto;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 20px 6%;
  color: var(--white);
  border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  background: rgba(8, 20, 38, 0.72);
  backdrop-filter: blur(16px);
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-shrink: 0;
}

.brand-icon {
  display: grid;
  place-items: center;
  width: 48px;
  height: 48px;
  color: var(--gold);
  border: 1px solid var(--gold);
  font-family: 'Playfair Display', serif;
  font-size: 32px;
  font-weight: 600;
  transform: rotate(-5deg);
}

.brand-name {
  font-family: 'Playfair Display', serif;
  font-size: 11px;
  letter-spacing: 2px;
  line-height: 1.6;
}

.brand-name strong {
  font-size: 13px;
}

.brand-name small {
  display: block;
  color: var(--gold);
  font-family: 'DM Sans', sans-serif;
  font-size: 8px;
  letter-spacing: 1.5px;
}

.navigation {
  display: flex;
  align-items: center;
  gap: 24px;
}

.navigation > a {
  position: relative;
  font-size: 12px;
  transition: color 0.3s ease;
}

.navigation > a:hover,
.navigation > a:focus-visible {
  color: var(--gold);
}

.navigation > a::after {
  position: absolute;
  right: 0;
  bottom: -7px;
  left: 0;
  height: 1px;
  background: var(--gold);
  content: '';
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.3s ease;
}

.navigation > a:hover::after {
  transform: scaleX(1);
}

.language-button {
  padding: 7px 11px;
  border: 1px solid var(--line);
  background: transparent;
  color: var(--gold);
  cursor: pointer;
}

.menu-toggle {
  display: none;
  padding: 7px 11px;
  border: 1px solid var(--line);
  background: transparent;
  color: var(--gold);
  font-size: 22px;
  cursor: pointer;
}

/* ACCUEIL */

.hero {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 690px;
  padding: 150px 11% 90px;
  isolation: isolate;
  overflow: hidden;
  color: var(--white);
  background: var(--navy);
}

.hero::before {
  position: absolute;
  z-index: -2;
  inset: 0;
  background-image: url('https://images.unsplash.com/photo-1497366754035-f200968a6e72?auto=format&fit=crop&w=2000&q=90');
  background-position: center;
  background-size: cover;
  content: '';
  animation: heroZoom 18s ease-in-out infinite alternate;
}

.hero-overlay {
  position: absolute;
  z-index: -1;
  inset: 0;
  background:
    linear-gradient(90deg,
      rgba(5, 15, 30, 0.97) 0%,
      rgba(5, 15, 30, 0.83) 43%,
      rgba(5, 15, 30, 0.2) 100%),
    linear-gradient(0deg, rgba(5, 15, 30, 0.3), transparent);
}

.hero-content {
  max-width: 760px;
}

.eyebrow {
  color: #b58b4a;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 3px;
  text-transform: uppercase;
}

.hero .eyebrow {
  color: var(--gold);
}

.hero h1 {
  margin: 22px 0;
  font-family: 'Playfair Display', Georgia, serif;
  font-size: clamp(38px, 5.5vw, 68px);
  font-weight: 500;
  line-height: 1.13;
  letter-spacing: -1.5px;
}

.hero-description {
  max-width: 580px;
  color: #d8dfeb;
  font-size: 15px;
  line-height: 1.9;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  margin-top: 30px;
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  min-height: 47px;
  padding: 12px 23px;
  border: 1px solid transparent;
  font-size: 12px;
  font-weight: 700;
  transition:
    transform 0.3s ease,
    background 0.3s ease,
    color 0.3s ease,
    border-color 0.3s ease;
}

.button:hover {
  transform: translateY(-3px);
}

.button-gold {
  color: var(--navy);
  background: linear-gradient(120deg, var(--gold-light), var(--gold));
}

.button-gold:hover {
  background: var(--white);
}

.button-outline {
  color: var(--white);
  border-color: rgba(255, 255, 255, 0.55);
}

.button-outline:hover {
  color: var(--gold);
  border-color: var(--gold);
}

.button-dark {
  color: var(--white);
  background: var(--navy);
}

.button-dark:hover {
  background: var(--navy-light);
}

.hero-location {
  margin-top: 45px;
  color: var(--gold);
  font-size: 10px;
  letter-spacing: 4px;
}

.hero-counter {
  position: absolute;
  right: 6%;
  bottom: 40px;
  color: var(--gold);
  font-size: 12px;
  letter-spacing: 3px;
}

.hero-counter span {
  color: #ffffff80;
}

/* TITRES */

section {
  scroll-margin-top: 25px;
}

.section-dark {
  color: var(--white);
  background: var(--navy);
}

.section-light {
  background: var(--ivory);
}

.services,
.news {
  padding: 90px 8%;
}

.section-heading {
  max-width: 650px;
  margin-bottom: 42px;
}

.section-heading h2,
.about-content h2,
.contact h2 {
  margin: 12px 0;
  font-family: 'Playfair Display', Georgia, serif;
  font-size: clamp(30px, 4vw, 43px);
  font-weight: 500;
  line-height: 1.25;
}

.section-heading > p:last-child {
  margin-top: 12px;
  color: var(--muted);
  font-size: 14px;
}

/* SERVICES */

.service-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
}

.service-card {
  position: relative;
  padding: 28px 23px;
  border: 1px solid rgba(255, 255, 255, 0.12);
  background: rgba(255, 255, 255, 0.025);
  transition:
    transform 0.35s ease,
    border-color 0.35s ease,
    background 0.35s ease;
}

.service-card:hover {
  transform: translateY(-7px);
  border-color: var(--gold);
  background: rgba(214, 178, 115, 0.06);
}

.service-icon {
  display: grid;
  place-items: center;
  width: 47px;
  height: 47px;
  margin-bottom: 24px;
  border: 1px solid var(--gold);
  border-radius: 50%;
  color: var(--gold);
  font-size: 25px;
}

.service-card h3 {
  margin-bottom: 13px;
  font-family: 'Playfair Display', Georgia, serif;
  font-size: 19px;
  font-weight: 500;
}

.service-card p {
  color: var(--muted);
  font-size: 12px;
  line-height: 1.9;
}

.service-card a {
  display: inline-block;
  margin-top: 22px;
  color: var(--gold);
  font-size: 11px;
  font-weight: 700;
}

/* CABINET */

.about {
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  align-items: center;
  gap: 7%;
  padding: 100px 8%;
}

.about-image {
  position: relative;
}

.about-image img {
  display: block;
  width: 100%;
  min-height: 350px;
  max-height: 520px;
  object-fit: cover;
}

.about-image::after {
  position: absolute;
  inset: 15px -15px -15px 15px;
  z-index: -1;
  border: 1px solid var(--gold);
  content: '';
}

.image-caption {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 15px;
  color: var(--white);
  background: rgba(8, 20, 38, 0.88);
  font-size: 9px;
  letter-spacing: 2px;
  text-align: center;
}

.about-content > p:not(.eyebrow) {
  margin: 20px 0;
  color: #626c7b;
  font-size: 14px;
}

.values {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
  margin: 28px 0;
  padding: 22px 0;
  border-top: 1px solid #ddd8cc;
  border-bottom: 1px solid #ddd8cc;
}

.values div {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.values strong {
  color: #b58b4a;
  font-family: 'Playfair Display', Georgia, serif;
  font-size: 24px;
}

.values span {
  font-size: 11px;
}

/* ACTUALITÉS */

.news {
  background:
    linear-gradient(rgba(8, 20, 38, 0.96), rgba(8, 20, 38, 0.98)),
    url('https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=1800&q=80') center/cover;
}

.news-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
}

.news-card {
  padding: 28px;
  border: 1px solid rgba(255, 255, 255, 0.15);
  background: rgba(255, 255, 255, 0.04);
  transition: border-color 0.3s ease;
}

.news-card:hover {
  border-color: var(--gold);
}

.news-card > span {
  color: var(--gold);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 2px;
}

.news-card h3 {
  margin: 18px 0 12px;
  font-family: 'Playfair Display', Georgia, serif;
  font-size: 21px;
  font-weight: 500;
  line-height: 1.4;
}

.news-card p {
  color: var(--muted);
  font-size: 13px;
}

/* CONTACT */

.contact {
  padding: 100px 8%;
  text-align: center;
}

.contact h2 {
  max-width: 700px;
  margin: 18px auto;
  color: var(--navy);
}

.contact > p:not(.eyebrow) {
  max-width: 650px;
  margin: 0 auto 27px;
  color: #626c7b;
  font-size: 14px;
}

/* PIED DE PAGE */

.footer {
  padding: 35px 7%;
  color: var(--muted);
  background: #050d19;
  text-align: center;
  font-size: 11px;
}

.footer-brand {
  display: inline-flex;
  flex-direction: column;
  margin-bottom: 15px;
  color: var(--gold);
  font-family: 'Playfair Display', Georgia, serif;
  font-size: 26px;
}

.footer-brand span {
  font-family: 'DM Sans', sans-serif;
  font-size: 9px;
  letter-spacing: 2px;
}

/* ANIMATIONS */

.reveal {
  opacity: 0;
  transform: translateY(25px);
  transition:
    opacity 0.8s ease,
    transform 0.8s ease;
}

.reveal.visible {
  opacity: 1;
  transform: translateY(0);
}

@keyframes heroZoom {
  from {
    transform: scale(1);
  }

  to {
    transform: scale(1.07);
  }
}

/* TABLETTES */

@media (max-width: 1050px) {
  .header {
    padding: 18px 4%;
  }

  .navigation {
    gap: 13px;
  }

  .navigation > a {
    font-size: 11px;
  }

  .brand-name {
    letter-spacing: 1px;
  }

  .service-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

/* TÉLÉPHONES */

@media (max-width: 760px) {
  .header {
    position: absolute;
    padding: 14px 5%;
  }

  .brand-icon {
    width: 41px;
    height: 41px;
    font-size: 27px;
  }

  .brand-name {
    font-size: 9px;
  }

  .brand-name strong {
    font-size: 11px;
  }

  .brand-name small {
    font-size: 7px;
  }

  .menu-toggle {
    display: block;
  }

  .navigation {
    position: absolute;
    top: 100%;
    right: 0;
    left: 0;
    display: none;
    align-items: stretch;
    flex-direction: column;
    gap: 0;
    padding: 10px 5% 20px;
    border-top: 1px solid var(--line);
    background: var(--navy);
  }

  .navigation.open {
    display: flex;
  }

  .navigation > a {
    padding: 12px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 13px;
  }

  .navigation > a::after {
    display: none;
  }

  .language-button {
    align-self: flex-start;
    margin-top: 12px;
  }

  .hero {
    min-height: 680px;
    padding: 145px 7% 90px;
  }

  .hero::before {
    background-position: 60% center;
  }

  .hero-overlay {
    background: linear-gradient(
      90deg,
      rgba(5, 15, 30, 0.95),
      rgba(5, 15, 30, 0.67)
    );
  }

  .hero h1 {
    font-size: clamp(37px, 10vw, 54px);
  }

  .hero-description {
    font-size: 14px;
  }

  .hero-actions {
    align-items: stretch;
    flex-direction: column;
  }

  .hero-actions .button {
    width: 100%;
  }

  .hero-location {
    font-size: 9px;
  }

  .services,
  .news {
    padding: 70px 6%;
  }

  .service-grid,
  .news-grid {
    grid-template-columns: 1fr;
  }

  .service-card {
    padding: 25px;
  }

  .about {
    grid-template-columns: 1fr;
    gap: 45px;
    padding: 75px 7%;
  }

  .about-image img {
    min-height: 250px;
  }

  .about-content h2 {
    font-size: 34px;
  }

  .values {
    gap: 7px;
  }

  .values span {
    font-size: 10px;
  }

  .contact {
    padding: 75px 7%;
  }

  .contact h2 {
    font-size: 33px;
  }
}

/* ACCESSIBILITÉ */

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }

  .reveal {
    opacity: 1;
    transform: none;
  }
}
